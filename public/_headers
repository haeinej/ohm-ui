# design.ohmmmm.com response headers (Cloudflare Workers static assets).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY

# Built files carry a content hash in their names.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The registry the shadcn CLI installs from. Short cache, so a new build reaches apps quickly.
/r/*
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=300
  Access-Control-Allow-Origin: *
