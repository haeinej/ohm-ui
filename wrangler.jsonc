// design.ohmmmm.com: the gallery as static pages with a canonical HTTPS/error-response Worker. Headers are in public/_headers.
// Deploy: npm run deploy (builds, prerenders every page into dist/client, then uploads it).
// The registry is served from the same place: https://design.ohmmmm.com/r/{name}.json
{
  "name": "ohm-design",
  "main": "scripts/worker.mjs",
  "account_id": "bf82067932bd22931840d77dd338d57f",
  "compatibility_date": "2026-10-30",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "design.ohmmmm.com", "custom_domain": true }
  ]
}
